# PiaArp: [keyPlain] [ss(`I, Im, VIb, VIm, IV, IVm, I7, VIb7, IV7, II7, Idim7`)]
# Dim: [keyPlain] [zipLongest(ss(`1234567`), ss(`↑↓`))]pos
