ExtendedIntervals: [ss(`3-3, 3-2, 3-1, 3:0, 3:1, 3:2, 3:3, 4-3, 4-2, 4-1, 4:0, 4:1, 4:2, 4:3`)]
# TODO: StringIntervals: zip by finger diff, because 4:12 = 4:23 = 4:34
Directions: [shuffle(timesUntil(8, shuffle(uniq(loopSubstringsG(`G,:D:A:E'`.split(':'), 4, 2))).at(0)))]over:hide [zipLongest(fields.over, ss(`vvvvnnnn`)).map(a=>a.join(''))]sheet:computed:hide [metroS(50, 8)]metro:show-1:inline 
