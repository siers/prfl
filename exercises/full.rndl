Scales3: [key]key:freeze:inline [ss(`1 2 2+1 3 3+1 3+2 4 4+1 4+2 4+3`)]:show-1:inline [metroS(42, 4)]metro:show-1:inline [shuffle(modeShifts(fields.key.at(0), zipLongestShuf(ss(`dia chr arp hm mm +1 -1 sub pos`), `,R`.split(`,`)).map(x=>x.join('')).join(' ')))]mode:cut-semi:maxlen-80:show-4 [shiftsMD(fields.mode.at(0), '1233-4:1-2-34', '011222233333')]:computed:show-1 [desMS(fields.mode.at(0)).additional]:computed
Arps3: [key]key:freeze:inline [ss(`1 2 2+1 3 3+1 3+2 4 4+1 4+2 4+3`)]:show-1:inline [metroS(42, 4)]metro:show-1:inline [shuffle(modeShifts(fields.key.at(0), zipLongestShuf(ss(`min maj dim7 dom`), `,R`.split(`,`)).map(x=>x.join('')).join(' ')))]mode:cut-semi:maxlen-80:show-4 [shiftsMD(fields.mode.at(0), '1233-4:1-2-34', '011222233333')]:computed:show-1 [desMS(fields.mode.at(0)).additional]:computed
