-=- warmup-tasks
VlnChrom: [zipLongest(keys(), ss(`↑↓`))] [ss(`triads 4ads 6bdom`)] [ss(`base inv1 inv2`)] [ss(`straight flips`)] [ss(`p1,p2a,p2b,p3,p4a,p4b,p5a,p5b,p6a,p6b,p7`)] [metroS(50, 8)]metro:show-1:inline
StringIntervals: [ss(`3:31 3:41 3:42 4:11 4:12 4:13 4:14 4:21 4:22 4:23 4:24 4:31 4:32 4:33 4:34 4:41 4:42 4:43 4:44`)]
ToneDiff: [zipLongest(shuffle(divide(range(ToneLib.semi(ToneLib.parseNote('c2')), ToneLib.semi(ToneLib.parseNote('e7'))), 5).map(pick)).map(s => ToneLib.semiToHertz(Number(s)).toFixed(2)), shuffle(\[50, 25, 12.5, 6.25, 3.125\]), shuffle(\[1, 1, -1, -1\])).flatMap(p => \[p, p, p\]).map(p => p.join('/'))]pairs:hide [fields.pairs.at(0).split('/').at(0)]base:computed:hide [(Number(fields.pairs.at(0).split('/').at(1)) * Number(fields.pairs.at(0).split('/').at(2))).toString()]cents:computed:hide [fields.pairs.map((p, i) => { const \[b, m, s\] = p.split('/'); return i % 3 == 0 ? `<${b}hz>2 <${(Number(b) * Math.pow(2, Number(m) * Number(s) / 1200)).toFixed(2)}hz>2` : `r1` })]toneSource:hide [fields.toneSource.at(0)]tones:computed:hide [fields.pairs.map((p, i) => { const \[b, m, s\] = p.split('/'); const c = Number(m) * Number(s); return i % 3 == 2 ? `${c > 0 ? 'HIGHER' : 'LOWER'} ${ToneLib.render(ToneLib.hertzCanonical(Number(b)))}/${forceSign(c)}c` : ` ` })]answer:show-2 [60]metro
FretSearch: [ \[...chunk(chunk(zipT(...ToneLibViolin.strings.map(s => zipT(...shuffle(divide(s.positions.slice(0, 13).map(p => { sen = pick(ToneLibViolin.embedNotePlusMinus(p, \[s.name\])); return \['GDAE'.split('').at(s.index), sen.note, pick(sen.availFingers) || '0'\]}), 2).map(shuffle))).flat() )).flatMap(shuffle).map((\[c, t, f\]) => ToneLib.renderSheet(t, 4, c, f)), 8).map(m => m.join(' ')), 2).map(b => b.join(' | ')), ''\]]examples:hide [fields.examples.at(0)]sheet:computed:hide [s('1n ' + '16f '.repeat(fields.examples.length - 1) + '4r')]next:hide
OutsideNotes: name [pickKeysShuf().flat()]

