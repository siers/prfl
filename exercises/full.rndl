-=- BowDistribution::
BowDistribution1: [ss(`12345678`)]:computed [\[...ss(`G D A E`), ...ss(`GD DA AE EA AD DG G D A E GD DA AE EA AD DG GDA DAE EAD ADE GDG DGD DAD ADA AEA EAE`)\]]:show-1 [metroS(50, 15)]metro:show-2:inline
BowDistribution1B: [zipLongestShuf(ss(`12345678`), ss(`G D A E`))]:computed [metroS(50, 15)]metro:show-2:inline
BowDistribution1BC: [zipLongestShuf(ss(`12345678`), ss(`G D A E`), s(`|p,`), ss(`12345`))]:computed [metroS(50, 15)]metro:show-2:inline
BowDistribution2: [zipLongestShuf(ss(`12345678`), ss(`G D A E (GD) (DA) (AE)`))]:computed [metroS(50, 15)]metro:show-2:inline
BowDistribution3: [zipT(ss(`12345678`), ss(`G D A E G D A E (GD) (DA) (AE) (GD) (DA) (AE) G/D D/G D/A A/D A/E E/A`))]:computed [metroS(50, 15)]metro:show-2:inline
BowDistribution4: [zipT(ss(`12345678`), zipLongest(ss(`GDAE`), ss(`(GD) (DA) (AE)`), ss(`G/D D/G D/A A/D A/E E/A`)).flatMap(x=>shuffle(x)), s(`:::::::::::::`), ss(`0/1 1/1 1/2 1/4 3/4 1/3 2/3`)).map(x=>x.join(``))]:maxlen-5000:computed [metroS(50, 15)]metro:show-1:inline
# BD4 requires some guarantee of a minimal distance, split at the middle or pick by constraint
