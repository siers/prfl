# ↑↓
{stops=`thirds fourths sixths octaves tenths harm unisons`;}
{shapes=`dim sixths ysaye tonic squares`;}
{modes=`1 2 3 4 5 6 7`;}
-=- scales
# sheet music from serialized notation: lilypond-ish, `hide` keeps it off the text line
# SheetDemo: play it [`c4n d4v e8n f8v | g2n r4 a'4.v`]sheet:hide
-=- scale-stops
ScaleStopsString: [key] [ss(stops)] [zipLongest(ss(`DAE`), ':', ss(`0+H-W+H, 0+W-H`), ss(`1234`))]
-=- bowing
BowingRainbow: [zipLongest(s('33% 50% 66%'), `:`, ss('G Dd Du Ad Au E'), `:`, ss('up down'))] [metroS(42, 4)]metro:show-1:inline
BowDistribution: [ss(`123468`)]:computed [\[...ss(`G D A E`), ...ss(`GD DA AE EA AD DG G D A E GD DA AE EA AD DG GDA DAE EAD ADE GDG DGD DAD ADA AEA EAE`)\]]:show-1 [metroS(50, 8)]metro:show-2:inline
Entrances: [zipLongestShuf(ss(`GDAE`), ss(`0/1 1/1 1/2↑ 1/2↓ 1/4↑ 1/4↓ 3/4↑ 3/4↓ 1/3↑ 1/3↓ 2/3↑ 2/3↓`), ss(`LS`))]:show-4
Directions: [ss(`↑↓↑↓↑↓↑↓`)] [ss(`↑↓↑↓↑↓↑↓`)] [ss(`↑↓↑↓↑↓↑↓`)] [ss(`↑↓↑↓↑↓↑↓`)] 
-=- shifting
#{after('2026-03-16', '')}ShiftingFourth: [key] position 4 [(`octaves from 1st, shifts 1-4 ${ss(`0 -1 +1`).join(' ')}, shifts interleaved`)] [ss(`G D A E`)]
0x ShiftingSlides: [key] [(ss(`GDAE`).map(s=>chromaticSlide(key, s))).join(', ')]
ShiftingSlides: quartertone [key] [ss(`GDAE`).map(s=>chromaticSlide(key, s))]
{after('2026-04-05', '')}ShiftingSevcik: [key] Sevcik, no gliss [ss(`G D A E`)]
ShiftingSnake: [key] position: [ss(`2 3 4 5 6 7`)], [ss(`G D A E`)]
SemitoneFrame: [ss(`GDEA`)] +[ss(`1 2 3 4 5 6 7`)]sem [zip(ss(`lyd, maj, min, phyr, `),shuffle(perm('1234')).map(x=>x.join('')))]
# ShiftingAgainstWall: [ss(`snake, scale, ysaye`)]
UnisonShifts: [ss(`GDAE`)] +[ss(`3 4 5 6 7`)]sem
-=- vibrato
Vibrato: [ss(`12345678`)]:computed [shuffle(frets(10))]:show-4 [ss(`↑↓↑↓`)] spitze narrow [metroS(42, 4)]metro:show-1:inline
